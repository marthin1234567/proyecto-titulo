APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# --- Producción (HTTPS / proxy / hosting compartido) ---
# URL pública del sitio (sin barra final). Ej. https://agromec.horizontedigital.cl
# APP_URL=https://agromec.horizontedigital.cl
# Confía en cabeceras X-Forwarded-* del balanceador o del hosting (* = todos los proxies).
# En local déjalo vacío o comenta la línea.
# TRUSTED_PROXIES=*
# Genera enlaces con https:// aunque el servidor interno sea http (típico detrás de proxy SSL).
# FORCE_HTTPS=true
# Cookies de sesión solo por HTTPS (recomendado en producción con HTTPS).
# SESSION_SECURE_COOKIE=true
# Opcional: mismo valor que APP_URL salvo que uses CDN solo para /build:
# ASSET_URL="${APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

FIREBASE_PROJECT_ID=agromec-2b514
FIREBASE_API_KEY=
FIREBASE_STORAGE_BUCKET=agromec-2b514.firebasestorage.app
FIREBASE_WEB_CLIENT_ID=
FIREBASE_CREDENTIALS=

VITE_APP_NAME="${APP_NAME}"
VITE_FIREBASE_PROJECT_ID="${FIREBASE_PROJECT_ID}"
VITE_FIREBASE_API_KEY="${FIREBASE_API_KEY}"
VITE_FIREBASE_STORAGE_BUCKET="${FIREBASE_STORAGE_BUCKET}"
VITE_FIREBASE_WEB_CLIENT_ID="${FIREBASE_WEB_CLIENT_ID}"
